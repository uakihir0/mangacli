{
  "name": "mangacli",
  "version": "0.1.0",
  "description": "Render Japanese-style manga pages with a hand-drawn look from YAML or TypeScript objects.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mangacli": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "catalog",
    "assets",
    "schema.json",
    "README.md",
    "README.ja.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/build-schema.ts",
    "build:schema": "tsx scripts/build-schema.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "cac": "^7.1.0",
    "chokidar": "^6.0.0",
    "harfbuzzjs": "^1.6.4",
    "polygon-clipping": "^0.15.7",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
